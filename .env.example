# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret used to sign stateless auth tokens across instances.
JWT_SECRET="alertnet-dev-jwt-secret-change-in-production"

# VAPID Keys for Web Push Notifications (auto-generated in dev if omitted)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@alertnet.local"

# Google Maps Platform API Key (Optional - enables Google Maps JS API layer)
VITE_GOOGLE_MAPS_API_KEY=""

# PostgreSQL Connection (Optional - uses durable local file store when unset)
DATABASE_URL=""
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Redis & RabbitMQ Connection URLs (Optional - uses built-in multi-instance broker when unset)
REDIS_URL=""
RABBITMQ_URL=""

# SMTP Email Service (Optional - uses transparent demo audit log when unset)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AlertNet Emergency <alerts@alertnet.local>"

# Twilio SMS Service (Optional - uses transparent demo audit log when unset)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
